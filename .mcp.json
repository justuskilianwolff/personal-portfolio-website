{
	"mcpServers": {
		"svelte": {
			"type": "stdio",
			"command": "npx",
			"args": ["-y", "@sveltejs/mcp"],
			"env": {}
		},
		"playwright": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"@playwright/mcp@latest",
				"--headless",
				"--isolated",
				"--output-dir",
				".playwright-mcp",
				"--caps",
				"vision,pdf",
				"--codegen",
				"typescript",
				"--viewport-size",
				"1920x1080"
			]
		}
	}
}
